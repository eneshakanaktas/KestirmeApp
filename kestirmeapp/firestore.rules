rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Yardımcı fonksiyonlar
    // ---------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Güncellemede değişen alanlar yalnızca verilen listedeki alanlar mı?
    // (Dokümandaki diğer alanlar - ad, telefon vb. - sorun çıkarmaz.)
    function changedOnly(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ---------------------------------------------------------------
    // RANDEVULAR
    // ---------------------------------------------------------------
    match /appointments/{appointmentId} {

      // Müşteri kendi, berber kendine gelen randevuları görür
      allow read: if isSignedIn() && (
        resource.data.customerId == uid() ||
        resource.data.barberId == uid()
      );

      // Müşteri kendi adına, "pending" durumunda randevu oluşturur
      allow create: if isSignedIn()
        && request.resource.data.customerId == uid()
        && request.resource.data.keys().hasAll(
             ['customerId', 'barberId', 'date', 'time', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn() && (
        // Müşteri: bekleyen/onaylı randevuyu iptal eder
        (
          resource.data.customerId == uid()
          && changedOnly(['status', 'updatedAt'])
          && (resource.data.status == 'pending' || resource.data.status == 'approved')
          && request.resource.data.status == 'cancelled'
        )
        ||
        // Müşteri: tamamlanmış randevuyu değerlendirir (puan/yorum)
        (
          resource.data.customerId == uid()
          && resource.data.status == 'completed'
          && changedOnly(['comment', 'rating', 'reviewedAt', 'isEvaluated', 'evaluatedAt'])
        )
        ||
        // Berber: pending -> approved/cancelled, approved -> completed
        (
          resource.data.barberId == uid()
          && changedOnly(['status', 'updatedAt'])
          && (
            (resource.data.status == 'pending' &&
              (request.resource.data.status == 'approved' || request.resource.data.status == 'cancelled'))
            ||
            (resource.data.status == 'approved' && request.resource.data.status == 'completed')
          )
        )
      );

      // Geçmiş (tamamlanan/iptal) randevuyu taraflardan biri silebilir
      allow delete: if isSignedIn()
        && (resource.data.customerId == uid() || resource.data.barberId == uid())
        && (resource.data.status == 'completed' || resource.data.status == 'cancelled');
    }

    // ---------------------------------------------------------------
    // BERBERLER (salon profilleri)
    // ---------------------------------------------------------------
    match /barbers/{barberId} {

      allow read: if isSignedIn();

      // Berber yalnızca kendi profilini oluşturur
      allow create: if isSignedIn()
        && barberId == uid()
        && request.resource.data.createdAt == request.time
        && (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount == 0)
        && (!('ratingTotal' in request.resource.data) || request.resource.data.ratingTotal == 0);

      allow update: if isSignedIn() && (
        // Berber kendi profilini günceller (puan alanlarına dokunamaz)
        (
          barberId == uid()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratingCount', 'ratingTotal'])
        )
        ||
        // Puanlama: müşteri değerlendirme gönderirken puan toplamını günceller
        (
          changedOnly(['ratingCount', 'ratingTotal', 'updatedAt'])
          && request.resource.data.ratingCount == resource.data.get('ratingCount', 0) + 1
          && request.resource.data.ratingTotal >= resource.data.get('ratingTotal', 0) + 1
          && request.resource.data.ratingTotal <= resource.data.get('ratingTotal', 0) + 5
        )
      );

      allow delete: if false;

      // Müşteri yorumları: barbers/{id}/reviews
      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == uid()
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // BİLDİRİMLER
    // ---------------------------------------------------------------
    match /notifications/{notificationId} {

      // Herkes yalnızca kendi bildirimlerini okur
      allow read: if isSignedIn() && resource.data.userId == uid();

      // Uygulama, randevu işlemlerinde karşı tarafa bildirim oluşturur
      allow create: if isSignedIn()
        && request.resource.data.userId is string
        && request.resource.data.isRead == false;

      // Yalnızca "okundu" işaretlenebilir
      allow update: if isSignedIn()
        && resource.data.userId == uid()
        && changedOnly(['isRead', 'readAt'])
        && request.resource.data.isRead == true;

      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ---------------------------------------------------------------
    // KULLANICILAR
    // ---------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && userId == uid();
      allow delete: if false;
    }

    // Diğer her şey yasak
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
